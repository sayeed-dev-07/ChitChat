<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ChitChat - Home</title>

    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@700&family=Outfit:wght@400;500;600&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <div class="app-container">

        <header class="app-header">
            <h1>
                <%= title %>
            </h1>
        </header>

        <main class="chat-feed">
            <% for (let i=0; i < messages.length; i++) { %>
                <div class="message-card">
                    <div class="message-header">
                        <span class="message-user">
                            <%= messages[i].user %>
                        </span>
                        <span class="message-time">
                            <%= messages[i].added %>
                        </span>
                    </div>
                    <p class="message-text">
                        <%= messages[i].text %>
                    </p>
                    <div class="details">
                        <a href="<%= messages[i].id %>/details">details</a>
                    </div>
                </div>
                <% } %>

                    <div class="new-message-wrapper">
                        <a href="/new" class="btn">Write a Message</a>
                    </div>
        </main>


    </div>
    <div class="credits">
        Developed by <a href="https://github.com/sayeed-dev-07" target="_blank">Sayeed</a>
    </div>

</body>

</html>