<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ChitChat - <%= data.user %>'s Message</title>

    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@700&family=Outfit:wght@400;500;600&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <div class="app-container">

        <header class="app-header">
            <h1>ChitChat</h1>
        </header>

        <div class="form-container">
            <a href="/" class="back-link">← Back to Chat</a>

            <div class="details-card">
                <div class="detail-group">
                    <span class="detail-label">User</span>
                    <p class="detail-value user-name">
                        <%= data.user %>
                    </p>
                </div>

                <div class="detail-group ">
                    <span class="detail-label">Message</span>
                    <p class="detail-value message-highlight messageDetails">
                        <%= data.text %>
                    </p>
                </div>

                <div class="detail-group">
                    <span class="detail-label">Created</span>
                    <p class="detail-value time-stamp">
                        <%= data.added %>
                    </p>
                </div>
            </div>

        </div>

    </div>

    <div class="credits">
        Developed by <a href="https://github.com/sayeed-dev-07" target="_blank">Sayeed</a>
    </div>
</body>

</html>