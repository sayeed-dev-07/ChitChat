<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ChitChat - New Message</title>

    <link
        href="https://fonts.googleapis.com/css2?family=Caveat:wght@700&family=Outfit:wght@400;500;600&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <div class="app-container">

        <header class="app-header">
            <h1>ChitChat</h1>
        </header>

        <div class="form-container">

            <a href="/" class="back-link">← Back to Chat</a>

            <form method="POST" action="/new">

                <!-- General validation errors -->
                <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
                    <div class="error-container">
                        <% errors.forEach(error => { %>
                            <p class="error-message">
                                <%= error.msg %>
                            </p>
                        <% }) %>
                    </div>
                <% } %>


                <div class="form-group">
                    <label for="authorName">Display Name</label>

                    <input
                        placeholder="Who are you?"
                        name="authorName"
                        id="authorName"
                        type="text"
                        value="<%= typeof oldData !== 'undefined' ? oldData.authorName : '' %>"
                        required
                    >

                    <% if (typeof errors !== 'undefined') { %>
                        <% const authorError = errors.find(error => error.path === 'authorName') %>

                        <% if (authorError) { %>
                            <p class="field-error">
                                <%= authorError.msg %>
                            </p>
                        <% } %>
                    <% } %>
                </div>


                <div class="form-group">
                    <label for="inputMessage">Your Message</label>

                    <textarea
                        placeholder="What's on your mind?"
                        name="inputMessage"
                        id="inputMessage"
                        rows="4"
                        required
                    ><%= typeof oldData !== 'undefined' ? oldData.inputMessage : '' %></textarea>

                    <% if (typeof errors !== 'undefined') { %>
                        <% const messageError = errors.find(error => error.path === 'inputMessage') %>

                        <% if (messageError) { %>
                            <p class="field-error">
                                <%= messageError.msg %>
                            </p>
                        <% } %>
                    <% } %>
                </div>


                <button type="submit" class="btn">
                    Send Message
                </button>

            </form>
        </div>

    </div>

    <div class="credits">
        Developed by
        <a href="https://github.com/sayeed-dev-07" target="_blank">
            Sayeed
        </a>
    </div>

</body>

</html>